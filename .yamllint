---
extends: default

rules:
  line-length:
    max: 79
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
    # Keep action versions inline so Dependabot updates them with SHA pins.
    ignore: |
      /.github/workflows/
  document-start: disable
  comments:
    min-spaces-from-content: 1
  truthy:
    check-keys: false

ignore: |
  .agents/
  .venv/
  openspec/changes/
  tests/fixtures/
